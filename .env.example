# ============================================================================
# OpsPilot AI Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env or any file containing secrets to version control.

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/opspilot_ai

# ============================================================================
# Server Configuration
# ============================================================================
# HTTP server port (default: 3000)
PORT=3000

# Node environment (development, production, staging)
NODE_ENV=development

# Log level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# ============================================================================
# Authentication Configuration
# ============================================================================
# JWT signing secret (required for production)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# JWT token expiration (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,http://localhost:5173,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# Demo Mode Configuration
# ============================================================================
# Enable demo mode to load synthetic seed data
# In production, this should be false or omitted
DEMO_MODE=false

# ============================================================================
# API Rate Limiting
# ============================================================================
# Maximum number of requests per window
RATE_LIMIT_MAX=100

# Time window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# Optional: AI Provider Configuration
# ============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# Optional: Notification Service Configuration
# ============================================================================
# SENDGRID_API_KEY=SG....
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
